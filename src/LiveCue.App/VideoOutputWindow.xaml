<Window x:Class="LiveCue.App.VideoOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        Background="Black">
    <Grid Background="Black">
        <!-- Pan/zoom/rotate (see VideoCue.Zoom/OffsetX/OffsetY/Rotation) applied as a plain visual
             transform on the video surface itself - the Grid stays put so the pixel-exact
             SetWindowPos placement is never affected by it. -->
        <vlc:VideoView x:Name="VideoViewControl" RenderTransformOrigin="0.5,0.5">
            <vlc:VideoView.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomTransform"/>
                    <RotateTransform x:Name="RotateTransformPart"/>
                    <TranslateTransform x:Name="PanTransform"/>
                </TransformGroup>
            </vlc:VideoView.RenderTransform>
        </vlc:VideoView>
    </Grid>
</Window>
