<Window x:Class="LiveCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiveCue.App"
        mc:Ignorable="d"
        Icon="/Assets/LiveCue.ico"
        Title="{Binding WindowTitle}" Height="650" Width="1100"
        WindowState="Maximized"
        Background="#44BF63">
    <Window.Resources>
        <!-- Brand green, sampled from the app logo - the whole window reads off this instead of the old dark theme. -->
        <SolidColorBrush x:Key="BrandGreen" Color="#44BF63"/>
        <SolidColorBrush x:Key="BrandGreenDark" Color="#2E8B4A"/>
        <SolidColorBrush x:Key="RowTintA" Color="#9ED9AE"/>
        <SolidColorBrush x:Key="RowTintB" Color="#B6E4C2"/>

        <!-- Toolbar button groups: color signals what a button does, not just its row position. -->
        <SolidColorBrush x:Key="AddCueAmber" Color="#F5A623"/>
        <SolidColorBrush x:Key="DeleteOrange" Color="#EF6C00"/>
        <SolidColorBrush x:Key="UndoRedoSlate" Color="#78909C"/>
        <SolidColorBrush x:Key="MonitorBlue" Color="#1E88E5"/>

        <!-- Rounded-corner button: WPF's stock Button chrome has no CornerRadius of its own,
             so the shape has to come from a custom template rather than a Style setter. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandGreenDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandGreenDark}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BrandGreenDark}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandGreenDark}"/>
        </Style>
        <!-- A disarmed ("Attiva" unchecked) cue is dimmed, instead of looking identical to one
             that will actually fire on GO/in a chain - the armed rows read as "the real show"
             just by contrast, with no change needed on their own styling. -->
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArmed}" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <local:IsNotLastCueConverter x:Key="IsNotLastCueConverter"/>
        <local:SecondsConverter x:Key="SecondsConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:CueKindVisibilityConverter x:Key="CueKindVisibilityConverter"/>
        <local:RotationSupportedConverter x:Key="RotationSupportedConverter"/>
        <local:CueTypeIconConverter x:Key="CueTypeIconConverter"/>
        <local:FileSizeConverter x:Key="FileSizeConverter"/>
        <local:BitrateConverter x:Key="BitrateConverter"/>
        <local:NullableSecondsConverter x:Key="NullableSecondsConverter"/>

        <!-- Inspector: compact label/value pairs, used throughout the "Informazioni" tab. -->
        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="InspectorValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <!-- ESC = panic button: stops every cue and all playback immediately, from anywhere in the window. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding PanicCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: taller than before (bigger padding/font on every button) and on the brand green. -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Background="{StaticResource BrandGreenDark}" MinHeight="56">
            <Button Content="Nuovo" Command="{Binding NewProjectCommand}"/>
            <Button Content="Apri..." Command="{Binding LoadProjectCommand}"/>
            <Button Content="Salva..." Command="{Binding SaveProjectCommand}"/>
            <Separator Margin="8,0"/>
            <Button Content="▶ Video Cue" Command="{Binding AddVideoCueCommand}" Background="{StaticResource AddCueAmber}"/>
            <Button Content="♪ Audio Cue" Command="{Binding AddAudioCueCommand}" Background="{StaticResource AddCueAmber}"/>
            <Button Content="▭ Image Cue" Command="{Binding AddImageCueCommand}" Background="{StaticResource AddCueAmber}"/>
            <Button Content="◐ Fade Cue" Command="{Binding AddFadeCueCommand}" Background="{StaticResource AddCueAmber}"/>
            <Button Content="■ Stop Cue" Command="{Binding AddStopCueCommand}" Background="{StaticResource AddCueAmber}"/>
            <Button Content="Elimina" Command="{Binding RemoveSelectedCueCommand}" Background="{StaticResource DeleteOrange}" Foreground="White"/>
            <Separator Margin="8,0"/>
            <Button Content="↶ Annulla" Command="{Binding UndoCommand}" ToolTip="{Binding UndoTooltip}" Background="{StaticResource UndoRedoSlate}" Foreground="White"/>
            <Button Content="↷ Ripeti" Command="{Binding RedoCommand}" ToolTip="{Binding RedoTooltip}" Background="{StaticResource UndoRedoSlate}" Foreground="White"/>
            <Separator Margin="8,0"/>
            <Button Content="Monitor..." Click="OpenMonitorManager_Click" Background="{StaticResource MonitorBlue}" Foreground="White"/>
            <Button Content="Monitor live..." Click="OpenMonitorPreview_Click" Background="{StaticResource MonitorBlue}" Foreground="White"/>
            <Separator Margin="8,0"/>
            <Button Content="GO" Command="{Binding GoCommand}" Background="#2E7D32" Foreground="White" FontWeight="Bold" Width="90"/>
            <Button Content="PANIC (ESC)" Command="{Binding PanicCommand}" Background="#C62828" Foreground="White" FontWeight="Bold" Width="110"/>
        </StackPanel>

        <!-- Cue list: back to filling the whole row, now on the brand green instead of white. -->
        <DataGrid x:Name="CueGrid" Grid.Row="1"
                  ItemsSource="{Binding CueList.Cues}"
                  SelectedIndex="{Binding CueList.SelectedIndex, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  AllowDrop="True"
                  Drop="CueGrid_Drop"
                  DragOver="CueGrid_DragOver"
                  Background="{StaticResource BrandGreen}"
                  Foreground="Black"
                  RowBackground="{StaticResource RowTintA}"
                  AlternatingRowBackground="{StaticResource RowTintB}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Margin="4">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Drag handle: trascina da qui per spostare la cue prima/dopo le altre. -->
                                <TextBlock Text="&#9776;" Foreground="#666" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Cursor="SizeAll"
                                           MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                           MouseMove="DragHandle_MouseMove"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Converter={StaticResource CueTypeIconConverter}}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="160"/>
                    <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="260">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FileMissing}" Value="True">
                                        <Setter Property="Foreground" Value="#FF5252"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="ToolTip" Value="File non trovato"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Fade/Stop cue only: # of the cue it acts on, and (Fade only) the fade's own length in seconds. -->
                    <DataGridTextColumn Header="Target" Binding="{Binding TargetCueNumber}" Width="60"/>
                    <DataGridTextColumn Header="Fade (s)" Binding="{Binding FadeSeconds}" Width="70"/>
                    <!-- Image cue only: how long to show it before continuing on its own; 0 = stays up until stopped. -->
                    <DataGridTextColumn Header="Mostra (s)" Binding="{Binding DisplaySeconds}" Width="80"/>
                    <!-- Seconds ("2,5"), or m:ss. A bare TimeSpan binding would read "5" as five days. -->
                    <DataGridTextColumn Header="Pre-wait (s)" Binding="{Binding PreWait, Converter={StaticResource SecondsConverter}}" Width="90"/>
                    <DataGridTextColumn Header="Post-wait (s)" Binding="{Binding PostWait, Converter={StaticResource SecondsConverter}}" Width="90"/>
                    <DataGridTextColumn Header="Durata" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Countdown" Binding="{Binding RemainingTime, StringFormat=hh\\:mm\\:ss}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="18"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Foreground" Value="#FF5252"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Continue" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- The last cue in the list has nothing to chain into, so it can only ever be "Non continua". -->
                                <ComboBox ItemsSource="{x:Static local:MainViewModel.ContinueModeOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding ContinueMode, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" Margin="2">
                                    <ComboBox.IsEnabled>
                                        <MultiBinding Converter="{StaticResource IsNotLastCueConverter}">
                                            <Binding/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.CueList.Cues"/>
                                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.CueList.Cues.Count"/>
                                        </MultiBinding>
                                    </ComboBox.IsEnabled>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Schermo" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DisplayTargets}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{Binding TargetDisplayId, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" Margin="2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Volume" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Live: dragging this while the cue is playing fades it in real time (see MediaPlayerCuePlayer). -->
                                <Slider Minimum="0" Maximum="1" Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Loop" Binding="{Binding Loop}" Width="50"/>
                    <!-- Unchecked = the cue is skipped (GO and Continua chains pass over it). -->
                    <DataGridCheckBoxColumn Header="Attiva" Binding="{Binding IsArmed}" Width="50"/>
                </DataGrid.Columns>
            </DataGrid>

        <!-- Cue inspector: details and per-cue settings for whatever is selected above, QLab-style.
             Collapsed entirely when nothing is selected. Its own DataContext is the selected Cue
             itself (not the ViewModel) so every field binds directly to it; anything that needs
             the ViewModel (Schermo targets, Audio output devices) reaches up via AncestorType=Window,
             the same pattern the cue grid's own "Schermo"/"Continue" columns already use. -->
        <Border Grid.Row="2" Background="{StaticResource BrandGreenDark}" BorderBrush="{StaticResource BrandGreen}" BorderThickness="0,2,0,0"
                Visibility="{Binding CueList.SelectedCue, Converter={StaticResource NullToVisibilityConverter}}">
            <TabControl Height="220" Margin="6" DataContext="{Binding CueList.SelectedCue}">

                <TabItem Header="Informazioni">
                    <!-- The default tab-page chrome paints white; every tab's content is wrapped
                         in its own Border so the brand-dark background (and the white text on it)
                         actually show, instead of white-on-white. -->
                    <Border Background="{StaticResource BrandGreenDark}">
                    <WrapPanel Margin="12">
                        <StackPanel Width="420" Margin="0,0,24,0">
                            <TextBlock Text="File" Style="{StaticResource InspectorLabel}"/>
                            <TextBlock Text="{Binding FilePath}" Style="{StaticResource InspectorValue}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,24,0">
                            <TextBlock Text="Dimensione" Style="{StaticResource InspectorLabel}"/>
                            <TextBlock Text="{Binding FilePath, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource InspectorValue}"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,24,0">
                            <TextBlock Text="Durata" Style="{StaticResource InspectorLabel}"/>
                            <TextBlock Text="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Style="{StaticResource InspectorValue}"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,24,0">
                            <TextBlock Text="Risoluzione" Style="{StaticResource InspectorLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding VideoWidth}" Style="{StaticResource InspectorValue}"/>
                                <TextBlock Text="x" Style="{StaticResource InspectorValue}" Margin="2,0"/>
                                <TextBlock Text="{Binding VideoHeight}" Style="{StaticResource InspectorValue}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,24,0">
                            <TextBlock Text="Bitrate" Style="{StaticResource InspectorLabel}"/>
                            <TextBlock Text="{Binding Bitrate, Converter={StaticResource BitrateConverter}}" Style="{StaticResource InspectorValue}"/>
                        </StackPanel>
                        <StackPanel Width="90" Margin="0,0,24,0">
                            <TextBlock Text="Codec" Style="{StaticResource InspectorLabel}"/>
                            <TextBlock Text="{Binding Codec}" Style="{StaticResource InspectorValue}"/>
                        </StackPanel>
                        <StackPanel Width="140">
                            <TextBlock Text="Audio" Style="{StaticResource InspectorLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AudioChannels}" Style="{StaticResource InspectorValue}"/>
                                <TextBlock Text=" ch, " Style="{StaticResource InspectorValue}"/>
                                <TextBlock Text="{Binding AudioSampleRate}" Style="{StaticResource InspectorValue}"/>
                                <TextBlock Text=" Hz" Style="{StaticResource InspectorValue}"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Video" Visibility="{Binding Converter={StaticResource CueKindVisibilityConverter}, ConverterParameter=Video}">
                    <Border Background="{StaticResource BrandGreenDark}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Schermo:" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                            <ComboBox Width="220" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.DisplayTargets}"
                                      SelectedValuePath="Id" DisplayMemberPath="Label"
                                      SelectedValue="{Binding TargetDisplayId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Converter={StaticResource CueKindVisibilityConverter}, ConverterParameter=Filters}">
                            <TextBlock Text="Correzione colore (dal vivo mentre la cue è in riproduzione)" Foreground="#DDD" FontSize="11" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Luminosità" Foreground="White" VerticalAlignment="Center"/>
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Brightness, StringFormat=F1}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Contrasto" Foreground="White" VerticalAlignment="Center"/>
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Contrast, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Contrast, StringFormat=F1}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Saturazione" Foreground="White" VerticalAlignment="Center"/>
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" Value="{Binding Saturation, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Saturation, StringFormat=F1}" Foreground="White" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Zoom/posizione/rotazione: proprietà presenti sia su VideoCue che su
                             ImageCue (stessi nomi), quindi questa sezione resta fuori dal blocco
                             "Filters" (solo video) e vale per entrambi i tipi di cue. -->
                        <TextBlock Text="Zoom, posizione e rotazione (dal vivo mentre la cue è in riproduzione)" Foreground="#DDD" FontSize="11" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Zoom" Foreground="White" VerticalAlignment="Center"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0.2" Maximum="4" Value="{Binding Zoom, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Zoom, StringFormat=F1}" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Posizione X" Foreground="White" VerticalAlignment="Center"/>
                            <!-- +/-2000px: copre lo spostamento da bordo a bordo anche su schermi grandi
                                 (es. un 4K da 3840-4096px di larghezza), fisici o virtuali. -->
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-2000" Maximum="2000" Value="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OffsetX, StringFormat=F0}" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Posizione Y" Foreground="White" VerticalAlignment="Center"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-2000" Maximum="2000" Value="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OffsetY, StringFormat=F0}" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Rotazione" Foreground="White" VerticalAlignment="Center"
                                       IsEnabled="{Binding Converter={StaticResource RotationSupportedConverter}}"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Rotation, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                    IsEnabled="{Binding Converter={StaticResource RotationSupportedConverter}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Rotation, StringFormat=F0}" Foreground="White" VerticalAlignment="Center"
                                       IsEnabled="{Binding Converter={StaticResource RotationSupportedConverter}}"/>
                        </Grid>
                        <TextBlock Text="La rotazione non è disponibile per le cue video: la superficie video non può essere ruotata (funziona solo per le immagini)."
                                   Foreground="#FFD27A" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Converter={StaticResource CueKindVisibilityConverter}, ConverterParameter=Filters}"/>
                    </StackPanel>
                    </ScrollViewer>
                    </Border>
                </TabItem>

                <TabItem Header="Audio" Visibility="{Binding Converter={StaticResource CueKindVisibilityConverter}, ConverterParameter=Audio}">
                    <Border Background="{StaticResource BrandGreenDark}">
                    <StackPanel Margin="12" Orientation="Horizontal">
                        <TextBlock Text="Uscita audio:" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                        <ComboBox Width="260" ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.AudioOutputDevices}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name"
                                  SelectedValue="{Binding AudioOutputDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="In/Out" Visibility="{Binding Converter={StaticResource CueKindVisibilityConverter}, ConverterParameter=InOut}">
                    <Border Background="{StaticResource BrandGreenDark}">
                    <StackPanel Margin="12">
                        <TextBlock Text="Trascina i bordi gialli per impostare inizio/fine, o scrivi i secondi esatti." Foreground="#DDD" FontSize="11" Margin="0,0,0,8"/>
                        <local:TrimScrubber Duration="{Binding Duration}"
                                            TrimStart="{Binding TrimStart, Mode=TwoWay}"
                                            TrimEnd="{Binding TrimEnd, Mode=TwoWay}"
                                            WaveformPeaks="{Binding WaveformPeaks}"
                                            ThumbnailPaths="{Binding ThumbnailPaths}"
                                            IsAnalyzing="{Binding IsAnalyzing}"
                                            Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Inizio (s):" VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                            <TextBox Width="80" Text="{Binding TrimStart, Converter={StaticResource NullableSecondsConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Fine (s):" VerticalAlignment="Center" Foreground="White" Margin="24,0,8,0"/>
                            <TextBox Width="80" Text="{Binding TrimEnd, Converter={StaticResource NullableSecondsConverter}, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Border>

        <!-- Status bar: transient messages on the left, live system load on the right -->
        <Grid Grid.Row="3" Background="{StaticResource BrandGreenDark}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="White" FontSize="11" Padding="8,4"/>
            <TextBlock Grid.Column="1" Text="{Binding SystemStatusText}" Foreground="White" FontSize="11"
                       FontFamily="Consolas" Padding="8,4"/>
        </Grid>
    </Grid>
</Window>
