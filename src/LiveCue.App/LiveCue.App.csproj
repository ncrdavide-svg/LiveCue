<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LiveCue.Core\LiveCue.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LiveCue.ico" />
    <Resource Include="Assets\LiveCue.png" />
    <Resource Include="Assets\BuyMeACoffeeQR.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LiveCue</AssemblyName>
    <Product>LiveCue</Product>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets\LiveCue.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
