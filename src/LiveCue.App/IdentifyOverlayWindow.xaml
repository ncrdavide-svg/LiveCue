<Window x:Class="LiveCue.App.IdentifyOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        Background="#CC000000">
    <Grid>
        <Border Background="#1E1E1E" BorderBrush="#4FC3F7" BorderThickness="4"
                Width="260" Height="260" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="NumberText" FontSize="140" FontWeight="Bold"
                       Foreground="#4FC3F7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
