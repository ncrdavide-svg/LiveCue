<Window x:Class="LiveCue.App.ScreenTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Black"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" ClipToBounds="True">

        <!-- Geometry/alignment grid: filled in programmatically (cell count depends on the screen's own pixel size). -->
        <UniformGrid x:Name="GridLines" Opacity="0.35"/>

        <!-- Concentric circles: check for aspect-ratio distortion and edge curvature. Sized in code-behind. -->
        <Ellipse x:Name="CircleOuter" Stroke="#4FC3F7" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="CircleMiddle" Stroke="#4FC3F7" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse x:Name="CircleInner" Stroke="#4FC3F7" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Full-bleed diagonals + crosshair, to spot keystoning/misalignment at a glance. -->
        <Line x:Name="DiagonalA" Stroke="#4FC3F7" StrokeThickness="1" Opacity="0.5"/>
        <Line x:Name="DiagonalB" Stroke="#4FC3F7" StrokeThickness="1" Opacity="0.5"/>
        <Line x:Name="CrosshairH" Stroke="#4FC3F7" StrokeThickness="1" Opacity="0.5"/>
        <Line x:Name="CrosshairV" Stroke="#4FC3F7" StrokeThickness="1" Opacity="0.5"/>

        <!-- Corner + edge-midpoint markers: check overscan / that nothing gets cropped. -->
        <Rectangle Width="28" Height="28" Fill="#4FC3F7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#4FC3F7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#4FC3F7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#4FC3F7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#FF5252" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12"/>
        <Rectangle Width="28" Height="28" Fill="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"/>

        <!-- Colour bars along the top, the classic test-card strip. -->
        <UniformGrid Rows="1" Columns="8" VerticalAlignment="Top" Height="90">
            <Rectangle Fill="White"/>
            <Rectangle Fill="Yellow"/>
            <Rectangle Fill="Cyan"/>
            <Rectangle Fill="Lime"/>
            <Rectangle Fill="Magenta"/>
            <Rectangle Fill="Red"/>
            <Rectangle Fill="Blue"/>
            <Rectangle Fill="Black"/>
        </UniformGrid>

        <!-- Centre info card: logo, monitor name, resolution. -->
        <Border Background="#D9000000" BorderBrush="#4FC3F7" BorderThickness="2" CornerRadius="16"
                Padding="40,28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="/Assets/LiveCue.png" Width="72" Height="72" Margin="0,0,0,14"/>
                <TextBlock x:Name="MonitorNameText" FontSize="40" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="700" TextWrapping="Wrap"/>
                <TextBlock x:Name="ResolutionText" FontSize="24" Foreground="#4FC3F7"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Clicca in un punto qualsiasi per chiudere" FontSize="13" Foreground="#999"
                           HorizontalAlignment="Center" Margin="0,22,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
